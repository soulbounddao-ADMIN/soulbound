# Copy to .env.local (gitignored) and fill in. Never commit real values.
EXPO_PUBLIC_API_BASE_URL=https://your-deployed-web-origin.example
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: defaults to ${EXPO_PUBLIC_API_BASE_URL}/privacy
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# Optional, unused by the app (deletion/report go through /api/account and /api/reports)
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
EXPO_PUBLIC_REPORT_URL=
# IOS_BUNDLE_ID=com.soulbound.app
